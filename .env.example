# Keys can all be typed on /admin instead (encrypted at rest); anything set
# here is the fallback for a field left empty there.
# Route providers — a provider without a key is hidden from the picker.
TMAP_APP_KEY=
KAKAO_REST_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Nearby places: fuel prices (opinet.co.kr) and charger states (data.go.kr,
# 한국환경공단 전기자동차 충전소 정보). Without them Kakao still finds the places.
OPINET_KEY=
DATA_GO_KR_KEY=
# The owner's charger rates beyond the public one: "GS차지비 385 280; 에버온 360"
EV_TARIFFS=

# Roads: 한국도로공사 (data.ex.co.kr — rest areas, bus lanes) and
# ITS 국가교통정보센터 (its.go.kr — incidents ahead). Separate sign-ups.
EX_API_KEY=
ITS_API_KEY=
# 서울 열린데이터광장 (data.seoul.go.kr): Seoul's traffic lights.
SEOUL_API_KEY=

# Dynamic TTS (Qwen3-TTS through DashScope). Fixed phrases are pre-rendered
# into server/tts/ and never cost a call.
DASHSCOPE_API_KEY=
# A Qwen3-TTS voice name; Cherry and Serena are women, Ethan a man.
TTS_VOICE=Cherry

# Where the car reaches this server. Caddy gets a certificate for it.
DOMAIN=nav.example.com

# Our own router (docker compose starts it as "osrm"; at a desk, an osrm-routed of your own).
# Left empty, the 자체 route is not offered.
KOREA_OSRM_URL=

PORT=8080
